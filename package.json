{
  "name": "@probabl/pi-skill-lifecycle",
  "version": "0.4.0",
  "description": "OpenCode-style skill loading for Pi: a skill tool, a binding protocol, and archiving of skill bodies that are no longer relevant, with no configuration.",
  "keywords": [
    "pi-package",
    "skill-lifecycle",
    "skill-management"
  ],
  "license": "MIT",
  "author": "Probabl",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/probabl-ai/pi-skill-lifecycle.git"
  },
  "homepage": "https://github.com/probabl-ai/pi-skill-lifecycle#readme",
  "bugs": {
    "url": "https://github.com/probabl-ai/pi-skill-lifecycle/issues"
  },
  "files": [
    "extensions/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^3.1.3"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "PI_E2E=1 vitest run tests/e2e",
    "typecheck": "tsc --noEmit -p .",
    "replay": "node scripts/replay.ts"
  }
}
